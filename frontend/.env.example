# --- Frontend runtime config (example) ---
#
# EVERY value here is PUBLIC. entrypoint.sh writes them into /srv/config.js at
# container start, so anything placed here is served to every browser.
# A service-role key or an AI key in this file is a leak, not a misconfiguration.

APP_ENV=dev                      # dev shows the "development environment" banner
PORT=8080                        # Railway injects this; do not set it there
API_BASE_URL=https://<backend-public-domain>   # public HTTPS, never *.railway.internal
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon key>
