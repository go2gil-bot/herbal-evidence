# --- Backend environment (example; never commit real values) ---
APP_ENV=dev                      # dev | production
PORT=8000                        # Railway injects this; do not set it there

# Supabase - the project for THIS environment. Never cross dev and production.
SUPABASE_URL=https://<project-ref>.supabase.co          # public
SUPABASE_PUBLISHABLE_KEY=<anon key>                     # public by design
SUPABASE_SECRET_KEY=<service role key>                  # SECRET - server only
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Exact origins, comma separated. No wildcards.
FRONTEND_ORIGIN=https://<frontend-domain>
CORS_ALLOWED_ORIGINS=https://<frontend-domain>

# AI provider. With AI_PROVIDER=none, or no key, draft jobs record a
# not_configured failure - they never emit placeholder output.
AI_PROVIDER=none                 # none | openai
AI_MODEL=                        # from `python -m app.ai.models`, not from memory
AI_API_KEY=                      # SECRET

# Literature providers. Both work without a key; NCBI_API_KEY raises the rate
# limit from 3 to 10 requests/second. NCBI asks callers to identify themselves.
NCBI_API_KEY=                    # optional, SECRET
NCBI_CONTACT_EMAIL=              # optional

LOG_LEVEL=INFO
